            "s012_p": "Global mobility",
            "s013_p": "Visa-free travel across the Schengen area with a European Golden Visa, and visa-free access to more than 140 destinations with a second citizenship",
            "s014_p": "<span class=\"immbds-proof-box\"><span class=\"immbds-ms immbds-s26\">trending_up</span></span>",
            "s015_p": "Protect and grow your wealth",
