            "s054_li": "<span class=\"immbds-ms\">check_circle</span><span>Residence rights for your spouse, children, and parents (depending on the program)</span>",
            "s055_li": "<span class=\"immbds-ms\">check_circle</span><span>Travel in the Schengen area under the European Golden Visa programs</span>",
