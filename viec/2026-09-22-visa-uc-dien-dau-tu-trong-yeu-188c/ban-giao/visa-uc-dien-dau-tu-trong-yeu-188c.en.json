                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the 188C visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The 188C Significant Investor visa was the Significant Investor stream of Australia's Business Innovation and Investment Program, for investors with substantial financial capacity.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Investors placed A$5,000,000 in a complying significant investment in Australia.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The investment has to be held as required before the investor can apply for 888C permanent residence.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A spouse or partner and children under 23 could be included in the same application.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The program closed permanently to new applications on July 31, 2024. This page is a reference for applications already lodged and for the 888C stage that follows.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
            ],
