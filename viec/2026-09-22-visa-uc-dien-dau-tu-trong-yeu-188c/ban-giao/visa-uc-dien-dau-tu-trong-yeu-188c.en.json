            "product_faq_title": "188C visa FAQs",
            "product_faq_section_id": "faq-188c",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "Is the 188C visa still open to new applications?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Program status",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. The 188C Significant Investor stream closed permanently to new applications on July 31, 2024. Applications lodged before that date continue to be processed under the rules in force."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Did the 188C require running a business in Australia?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "How the investment works",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. The 188C was based on a complying significant investment, and it did not require the investor to establish or run a business."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Was proof of source of funds required?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Source of funds",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Investors had to show that the A$5,000,000 investment came from a lawful source of funds."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is the investment at risk?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Investment risk",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Investing through funds puts capital at risk. Returns, and the return of the capital itself, depend on how the funds perform and on the terms of the investment."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does a loss in the funds affect the 888C application?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Effect on the 888C stage",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The core condition is that the complying significant investment is held as required. Even so, the outcome depends on the individual case and on the decision of the Department of Home Affairs."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Was English required?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "English",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No level of English was required. Where functional English was not shown, the applicant and family members aged 18 and over may have had to pay the second instalment of the visa application charge that applied when the application was lodged."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does the 188C visa include Medicare?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Medicare",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "During the 188C provisional stage, the family needs private health insurance. Medicare eligibility comes with permanent residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                }
