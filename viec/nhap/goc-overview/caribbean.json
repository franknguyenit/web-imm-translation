<section class=\"story-section bg-why dark-sec\" data-section=\"Vì Sao IMM\">\r\n  <div class=\"number-bg light\">IMM</div>\r\n  <div class=\"content-wrap\">\r\n    <div class=\"reveal text-center mb-8\">\r\n      <h2 class=\"serif\" style=\"font-size:clamp(28px,7vw,42px); font-weight:700; color:#fff; line-height:1.15; margin-bottom:16px;\">Vì sao chọn IMM Group?</h2>\r\n      <p style=\"line-height:1.7; color:rgba(255,255,255,0.85); margin:0 auto; max-width:640px;\">\r\n        Từ năm 2005, IMM Group là đơn vị tiên phong tư vấn đầu tư định cư và quốc tịch Caribbean cho nhà đầu tư Việt Nam.\r\n      </p>\r\n    </div>\r\n\r\n    <div class=\"why-grid\">\r\n      <div class=\"reveal why-card\">\r\n        <div class=\"why-card-head\">\r\n          <div class=\"ic\"><span class=\"n\">1</span></div>\r\n          <h3>21+ năm kinh nghiệm</h3>\r\n        </div>\r\n        <ul class=\"why-list\">\r\n          <li>Hai thập kỷ tư vấn đầu tư định cư quốc tế</li>\r\n          <li>625+ hồ sơ đầu tư định cư xử lý thành công</li>\r\n          <li>2.500+ visa được cấp cho các gia đình Việt Nam</li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"reveal reveal-1 why-card\">\r\n        <div class=\"why-card-head\">\r\n          <div class=\"ic\"><span class=\"n\">2</span></div>\r\n          <h3>Được chính phủ Caribbean cấp phép</h3>\r\n        </div>\r\n        <ul class=\"why-list\">\r\n          <li>Công ty Việt Nam đầu tiên và duy nhất được Grenada, St. Kitts &amp; Nevis, Dominica cấp phép</li>\r\n          <li>Trực tiếp tư vấn và thụ lý hồ sơ đầu tư lấy quốc tịch</li>\r\n          <li>Làm việc trực tiếp với cơ quan chính phủ, giảm trung gian và tăng bảo mật</li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"reveal reveal-2 why-card\">\r\n        <div class=\"why-card-head\">\r\n          <div class=\"ic\"><span class=\"n\">3</span></div>\r\n          <h3>Chuyên sâu chương trình CBI</h3>\r\n        </div>\r\n        <ul class=\"why-list\">\r\n          <li>Am hiểu chương trình quốc tịch Dominica, St. Kitts &amp; Nevis, Grenada</li>\r\n          <li>Tư vấn thêm chương trình thường trú Curaçao</li>\r\n          <li>Hỗ trợ chọn hình thức đầu tư: quyên góp Quỹ Chính phủ hoặc bất động sản được phê duyệt</li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"reveal reveal-3 why-card\">\r\n        <div class=\"why-card-head\">\r\n          <div class=\"ic\"><span class=\"n\">4</span></div>\r\n          <h3>Thẩm định hồ sơ chặt chẽ</h3>\r\n        </div>\r\n        <ul class=\"why-list\">\r\n          <li>Hỗ trợ chuẩn bị hồ sơ due diligence</li>\r\n          <li>Chứng minh nguồn tiền hợp pháp theo yêu cầu từng quốc gia</li>\r\n          <li>Chuyên viên đạt chứng chỉ IMC về đầu tư định cư quốc tế</li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"reveal why-card\">\r\n        <div class=\"why-card-head\">\r\n          <div class=\"ic\"><span class=\"n\">5</span></div>\r\n          <h3>Cam kết đồng hành lâu dài</h3>\r\n        </div>\r\n        <ul class=\"why-list\">\r\n          <li>Đặt quyền lợi khách hàng lên trước lợi ích công ty</li>\r\n          <li>Bảo mật thông tin khách hàng theo tiêu chuẩn cao, ký NDA khi cần</li>\r\n          <li>Sẵn sàng hoàn phí khi xảy ra rủi ro khách quan theo hợp đồng</li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"reveal reveal-1 why-card\">\r\n        <div class=\"why-card-head\">\r\n          <div class=\"ic\"><span class=\"n\">6</span></div>\r\n          <h3>Nhận và cho đi — Be Better Foundation</h3>\r\n        </div>\r\n        <ul class=\"why-list\">\r\n          <li>Từ 2025, IMM Group chính thức trở thành doanh nghiệp phi lợi nhuận</li>\r\n          <li>IMM Group cam kết đóng góp tối thiểu 51% lợi nhuận hằng năm vào Quỹ Be Better</li>\r\n          <li>Quỹ hỗ trợ học sinh, sinh viên khó khăn tiếp tục học tập và thay đổi tương lai</li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Khối số liệu chốt -->\r\n    <div class=\"reveal stat-strip\">\r\n      <div class=\"s\"><div class=\"n\" data-count=\"21\" data-suffix=\"+\">21+</div><div class=\"l\">năm kinh nghiệm</div></div>\r\n      <div class=\"s\"><div class=\"n\" data-count=\"625\" data-suffix=\"+\">625+</div><div class=\"l\">hồ sơ thành công</div></div>\r\n      <div class=\"s\"><div class=\"n\" data-count=\"2500\" data-suffix=\"+\" data-sep=\".\">2.500+</div><div class=\"l\">visa được cấp</div></div>\r\n      <div class=\"s\"><div class=\"n\" data-count=\"3\">3</div><div class=\"l\">quốc gia Caribbean cấp phép trực tiếp</div></div>\r\n      <div class=\"s\"><div class=\"n\">Toàn cầu</div><div class=\"l\">Danh mục định cư</div></div>\r\n    </div>\r\n\r\n  \r\n\r\n    <div class=\"reveal mt-8 text-center\">\r\n      <div class=\"rule-center gold\"><span class=\"dot\"></span></div>\r\n      <div class=\"serif-i\" style=\"font-size: 18px; color:#fff; margin-bottom:8px;\">\"Phục vụ bằng những giá trị chân chính\"</div>\r\n      <div style=\"font-size:14px; color:var(--gold-soft); letter-spacing:0.2em; text-transform:uppercase;\">— Tôn chỉ IMM Group —</div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<!-- ============== 05 — KHỐI LIÊN KẾT ============== -->\r\n<section class=\"story-section bg-light short\" data-section=\"Tham Khảo\">\r\n  <div class=\"content-wrap col\">\r\n    <div class=\"reveal\">\r\n      <div class=\"eyebrow\">Có thể bạn quan tâm</div>\r\n      <h3 class=\"serif\" style=\"font-size:22px; font-weight:700; color:var(--navy); margin-bottom:14px;\">Tìm hiểu các dịch vụ tư vấn từ IMM Group</h3>\r\n      <div class=\"link-grid\">\r\n        <a class=\"link-chip\" href=\"https://immgroup.com/cac-nuoc-vung-caribbean/quoc-tich-grenada/\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg> Quốc tịch Grenada</a>\r\n        <a class=\"link-chip\" href=\"https://immgroup.com/cac-nuoc-vung-caribbean/quoc-tich-dominica/\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg> Quốc tịch Dominica</a>\r\n        <a class=\"link-chip\" href=\"https://immgroup.com/cac-nuoc-vung-caribbean/quoc-tich-st-kitts-and-nevis/\" style=\"grid-column:1/-1;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg> Quốc tịch St. Kitts and Nevis</a>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\r\n\r\n<div class=\"flag-bar\"></div>"
