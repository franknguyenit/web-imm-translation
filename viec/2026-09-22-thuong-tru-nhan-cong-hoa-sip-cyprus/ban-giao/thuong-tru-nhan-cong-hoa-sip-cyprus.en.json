            "product_faq_title": "Cyprus Golden Visa FAQs",
            "product_faq_section_id": "faq-cyprus",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "Which investments qualify?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Invest at least €300,000 in just one of the following:",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "(1) up to 2 new residential units."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "(2) commercial property."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "(3) shares in a Cyprus company with at least 5 employees."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "(4) Cyprus investment funds (AIF/AIFLNP/RAIF)."
                                }
                            ],
                            "product_faq_item_section_note": "Most investors choose an apartment for the long-term ownership and the option to rent it out."
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What is Cypriot permanent residence, and how does it differ from citizenship?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Permanent residence is the right to live in Cyprus indefinitely — it is not citizenship.",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "With permanent residence, your whole family can live in Cyprus, set up a business, and educate your children there."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Once you meet the residence requirements, you may apply for Cypriot citizenship. Processing depends on your file and on the authorities."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How do Schengen and the EU differ?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Schengen is not the same as the EU",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The EU — the European Union: an intergovernmental organization of 27 countries."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Schengen: a border-free travel area of 29 countries."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Some EU countries are not in Schengen, and the reverse is also true."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Cyprus is an EU member state but is not part of the Schengen Area yet."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does permanent residence give me free movement in Schengen and the EU?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "You still need a visa for the EU and Schengen",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Because Cyprus is not in the Schengen Area and permanent residence does not grant free movement in the EU, you still need to apply for a visa — usually an eVisa, processed within a few days — when you travel to EU or Schengen countries."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "The right to live, work, and study in any EU country arises only once you hold Cypriot citizenship."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can I work in Cyprus on permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "You cannot take up employment",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Cypriot permanent residence does not allow you or your spouse to take up salaried employment."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "You may set up and run your own business. If you choose the share investment route, you can serve as a director of that company."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can my children study free of charge?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Free of charge at Cypriot public schools",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "From primary through the end of secondary school."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the requirements for Cypriot citizenship?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "The main requirements",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Lawful residence in Cyprus for at least 8 years — 2,920 days — within an 11-year period."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Continuous residence: you must have lived in Cyprus continuously for the 12 months immediately before you apply."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Cumulative residence: in the 10 years before that final 12-month period, you must have lived in Cyprus for at least 7 years in total, or 2,555 days."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "You still hold the original investment, and you have no criminal record in Cyprus or abroad."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Greek at CEFR level B1, and a basic knowledge of Cypriot society and institutions."
                                }
                            ],
                            "product_faq_item_section_note": "The requirements can change with the law — contact IMM Group for the current position."
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What does Cypriot citizenship give you?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Full EU citizenship rights.",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The Cypriot passport gives visa-free or visa-on-arrival access to more than 170 countries and is ranked among the 15 strongest passports on current passport indexes; you can live, study, and work freely across the 27 EU member states, and dual citizenship is allowed."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
