                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the Cyprus Golden Visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The Cyprus Golden Visa is a permanent residence program run by the Government of the Republic of Cyprus.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "It is open to non-EU investors and their families through an investment in Cypriot real estate from €300,000.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "No government donation is required, and there are no language, education, or management experience requirements.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Cyprus is an EU member state and is working toward joining the Schengen Area.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "It can be a first step toward Cypriot citizenship once you meet the residence requirements.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Who you can include: your legal spouse and children up to age 25 who are unmarried and financially dependent.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Investment levels and rules can change over time.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
            ],
