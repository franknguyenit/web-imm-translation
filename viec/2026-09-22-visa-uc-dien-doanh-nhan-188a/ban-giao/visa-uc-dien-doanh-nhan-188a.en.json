                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the 188A visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The 188A Business Innovation visa was the Business Innovation stream of Australia's Business Innovation and Investment Program, for experienced business owners establishing, acquiring, or franchising a business in Australia.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The investment requirement started at A$300,000 and varied with the requirements of each state or territory.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A spouse or partner and children under 23 could be included in the same application.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The 188A is a provisional visa with a pathway to the 888A permanent visa once the business and residence requirements are met.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The program closed permanently to new applications on July 31, 2024. This page is a reference for applications already lodged and for the 888A stage that follows.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
