            "product_faq_title": "Malta Golden Visa FAQs",
            "product_faq_section_id": "faq-malta",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "What are the investment risks?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "The two main risks",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Choosing a developer or project without a track record, or a property that does not qualify."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Investment funds from an unlawful source, which leads to refusal."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "IMM Group runs due diligence on every file before any contract is signed, to address source-of-funds risk up front."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is documenting my source of funds complicated?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Typically simpler than the United States, Australia, or Canada",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "You document 2 layers: the source of the funds you are investing, and the source of wealth behind them."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "For funds from a property sale, for example, you will need to show the year of purchase and the value at the time."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Every family documents this differently — contact IMM Group for advice on your own situation."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What does the investment consist of?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Choose one of two property routes: buy or rent",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Buy property from €375,000, or rent from €14,000 a year, held for 5 years."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "A government contribution of €37,000, an administrative fee of €60,000, and a €2,000 philanthropic donation."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Proof of assets from €500,000, of which €150,000 in liquid assets; or €650,000, of which €75,000 in liquid assets."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How long must the property be held, and when can I sell?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Held for at least 5 years",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "You commit to holding the property or the lease for at least 5 years; you are not required to file periodic proof during that time."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "After 5 years you may sell the property or end the lease without affecting your permanent residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How many days a year must I spend in Malta?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "No minimum stay is required to keep your permanent residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "You are not required to live in Malta to hold or renew your permanent residence."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "If you are aiming at Maltese citizenship, you will need to meet the actual residence requirements set by law — see the citizenship section."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the requirements for the main applicant?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Basic conditions",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Aged 18 or older, with no upper age limit."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "No qualifications, formal education, English-language ability, or management experience is required."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "You meet the background security and health requirements, and document a lawful source of funds."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Which family members can be included?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "A multigenerational family",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Your legal spouse."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Children, including adopted children, under 29 who are unmarried and financially dependent."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "The parents and grandparents of both spouses, where they are financially dependent."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Are adopted children and stepchildren eligible?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Adopted children and stepchildren under 29 are eligible where they are unmarried and financially dependent",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Adopted child: a legal certificate is required."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Stepchild: a legal certificate plus a notarized letter of consent from the spouse."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "IMM Group assists with preparing the documents."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How long is Maltese permanent residence valid, and how is it renewed?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "A 5-year card, renewable periodically",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The residence card is valid for 5 years and can be renewed as long as you continue to meet the conditions."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "After 6 years of permanent residence, you may be considered for a Maltese citizenship application if you meet the conditions."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can my spouse work in Malta?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Yes, by applying for a work permit",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "With Maltese permanent residence, your spouse can apply for a work permit in order to work in Malta."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do I get free movement in the Schengen Area and the EU?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Short stays in the Schengen Area — not a right to live or work elsewhere in the EU",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Visa-free travel across the 29 Schengen countries under the short-stay rule: 90 days in any 180-day period."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Travel to EU countries outside the Schengen Area still requires a visitor visa under each country's rules."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "The right to live, work, and study in any EU country arises only once you hold Maltese citizenship."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What is the difference between Schengen and the EU?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Schengen is not the same as the EU",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The EU — the European Union: an intergovernmental organization of 27 countries."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Schengen: a border-free travel area, currently 29 countries."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Some EU countries are not in Schengen, and the reverse is also true. Malta is a member of both."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the requirements for Maltese citizenship?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Naturalization requirements",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Aged 18 or older, and resident in Malta for the 12 months immediately before you apply."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Cumulative residence of 4 years within the 6 years before that 12-month period."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "You meet the English or Maltese language requirement, and have no criminal record in Malta or abroad."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
