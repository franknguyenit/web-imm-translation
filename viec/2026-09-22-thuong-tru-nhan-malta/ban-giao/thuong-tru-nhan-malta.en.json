                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the Malta Golden Visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The Malta Golden Visa — officially the Malta Permanent Residence Programme (MPRP) — is a Government of Malta program that grants permanent residence in Malta.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "It is open to investors from outside the EU, EEA, and Switzerland, and to their families, through a qualifying investment.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "You can live in Malta and travel in the Schengen Area on short stays under the 90/180-day rule.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Up to 4 generations of one family: your spouse, children under 29 who are unmarried and financially dependent, and the parents and grandparents on both sides.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Buy property from €375,000 or rent from €14,000 a year, together with the contributions set by the program.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
            ],
