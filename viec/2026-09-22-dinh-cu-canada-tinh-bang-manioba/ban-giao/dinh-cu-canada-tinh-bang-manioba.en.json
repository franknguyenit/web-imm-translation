                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the Manitoba Entrepreneur Pathway?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The Manitoba Entrepreneur Pathway, part of the Business Investor Stream under the Manitoba Provincial Nominee Program (MPNP), is designed for business owners and senior managers who want to invest in, acquire or operate a business in the province.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "You must run the business in Manitoba yourself to qualify for Canadian permanent residence.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Your spouse and children under 22 can be included in the same application.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The minimum investment is C$150,000 for a business outside the Manitoba Capital Region, or C$250,000 for a business within it.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
            ],
