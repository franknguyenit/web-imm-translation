            "product_faq_title": "Frequently asked questions about the Manitoba Entrepreneur Pathway",
            "product_faq_section_id": "faq-manitoba",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "Is a work permit the same as permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is a work permit the same as permanent residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. A work permit gives you temporary permission to live and work in Canada. You must complete your investment, business operating and residency commitments before you can apply for permanent residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do I have to run the business myself?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Do I have to run the business myself",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. You must personally manage and operate the business in Manitoba. IMM Group and our partners can help with the business plan, but we cannot run the business on your behalf."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does my family have to live in Manitoba?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Does my family have to live in Manitoba",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Before you hold permanent residence, you need to stay closely involved with the business in the province you applied to. Your family must live there in line with the commitments you made under the program."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "When can I move up to permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "When can I move up to permanent residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Once you have operated the business, met the residency conditions and completed your commitments to the province, you can apply for permanent residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do I have to prove my source of funds?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Do I have to prove my source of funds",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. You must document a lawful source of funds and show that your assets are legitimate and fully traceable. Eligible assets can include real estate, business assets, cash savings, and shares in private or publicly traded companies."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "After permanent residence, can the family live in another province?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "After permanent residence, can the family live in another province",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Once you hold Canadian permanent residence, you and your family are free to live and work in any province."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the main risks of the program?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "What are the main risks of the program",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Risk usually comes from a business plan that is not viable, failing to operate the business as committed, not creating or maintaining the required job, or weak documentation of your finances."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                }
