                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The 888C Significant Investor visa is Australia's permanent residence (PR) visa for investors who hold an eligible 188C visa.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The whole family — spouse or partner and dependent children — can be granted PR at the same time.",
