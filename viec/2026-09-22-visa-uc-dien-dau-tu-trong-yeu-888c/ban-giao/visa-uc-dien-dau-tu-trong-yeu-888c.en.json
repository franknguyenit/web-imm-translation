                        },
                        {
                            "product_hero_content_text_item": "No further investment is required.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Once they hold the 888C and meet the residence requirements, the family can move toward Australian citizenship.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The 888C is the permanent residence step for investors who already hold a 188C; the 188/888 program (BIIP) has stopped accepting new expressions of interest.",
                            "product_hero_content_text_subs": false
                        }
