            "product_faq_title": "888C visa FAQs",
            "product_faq_section_id": "faq-888c",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "How is the 888C different from the 188A and the 188B?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "The main differences",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The 188C and 888C streams have no age limit, no points test, and a flexible residence requirement (40 days per year). Processing times depend on the individual case and on current policy. The trade-off is a higher level of investment than for the 188A and the 188B."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the investment risks?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Key risks",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "A fund investment is an at-risk investment: its value can move with the performance of the fund."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Application risk comes from choosing a fund that does not meet the standard, from a source-of-funds explanation that is not fully documented, or from an advisor without the right experience."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "IMM Group reviews the fund and the file in detail before any contract is signed, to help manage that risk."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is the investor still eligible for the 888C if the fund loses money?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "The effect of a loss-making fund",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Where the investment falls in value because of how the fund performed rather than because capital was withdrawn, the investor remains eligible for the 888C, provided the investment was held for the required period and no capital was withdrawn early."
                                }
                            ],
                            "product_faq_item_section_note": "The investment is at risk."
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What source of funds evidence is required?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Source of funds",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Investors have to document a lawful, clean source of funds, to the same standard as in the U.S. and Canada."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "Eligible assets include real estate, business assets, savings, and shareholdings or listed shares — held in the name of the applicant and/or the spouse or partner."
                                },
                                {
                                    "product_faq_item_section_bullet_text": "The path of funds has to be explained clearly and backed by documents."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can capital be withdrawn after the 888C is lodged?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Withdrawing the capital",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes, once the investment has been held for the required period and the 888C application has been lodged. The timing of any withdrawal should be planned with your advisor, so that it does not affect the application."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is English required?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "English",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. Good English helps with points and avoids the second instalment visa application charge, which applies to applicants aged 18 and over. The amount follows the Department of Home Affairs (DoHA) fee schedule current at the time of lodgement."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do children go to school for free?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Education",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Once the 188 visa is granted, children can attend public school from primary through senior secondary, under the policy that applies to permanent residents and eligible visa holders; the exact conditions are set by each state."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How does Medicare work on the 188 and on the 888?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Medicare",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "At the 188 (provisional) stage there is normally no Medicare access, so private health cover is needed. Once the 888C (PR) is granted, the family is eligible for Medicare."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Up to what age can children be included?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Dependents",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Children under 23 who are still dependent can be included in the application, with age locked at the time the 188 visa is granted. It is worth checking each child's age early so that no one ages out."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What is the path to Australian citizenship?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Australian citizenship",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The citizenship criteria are assessed separately from PR: generally 4 years of lawful residence in Australia, of which at least 1 year as a permanent resident; no more than 90 days outside Australia in the final year; passing the citizenship test; good character; and meeting the language requirement."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do connections speed up a decision?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "How applications are decided",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "There is no such thing as using \"connections\" to have an application prioritized or the requirements relaxed — that would be against Australian law. Applications are decided on the data and the evidence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                }
            ],
