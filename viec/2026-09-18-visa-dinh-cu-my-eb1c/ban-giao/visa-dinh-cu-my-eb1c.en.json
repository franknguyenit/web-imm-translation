            "product_faq_items": [
                {
                    "product_faq_item_question": "Is EB-1C an immigrant visa?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "What EB-1C is",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. EB-1C is an immigrant visa category that grants a U.S. green card to managers and senior executives of multinational companies."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How is EB-1C different from L-1A?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "EB-1C vs. L-1A",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "L-1A is a temporary, nonimmigrant work visa. EB-1C is an immigrant visa that grants a green card if you meet the requirements."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How is EB-1C different from EB-5?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "EB-1C vs. EB-5",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "EB-5 requires a fixed investment in a qualifying project. EB-1C has no fixed investment amount, but requires a U.S. company that has been operating for at least 1 year and needs a senior leader to run it."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is the EB-1C green card conditional?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "An unconditional green card",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. EB-1C grants an unconditional green card, so you do not need to file a petition to remove conditions, as EB-5 investors must."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can my family come with me?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Family members",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Your spouse and children under 21 may receive green cards alongside you."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How long must the U.S. company have been operating?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Operating history of the U.S. company",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The U.S. subsidiary must have been operating effectively for at least 1 year before you begin the EB-1C application."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can I apply for U.S. citizenship after EB-1C?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "A path to citizenship",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes, potentially. After at least 5 years as permanent residents, and once you meet the naturalization requirements, you and your family may apply for U.S. citizenship."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the main risks of EB-1C?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Key risks",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The main risk lies in proving that the business is genuine and operating effectively, that the applicant holds a true senior managerial role, and that the U.S. company has a real need for that role."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                }
