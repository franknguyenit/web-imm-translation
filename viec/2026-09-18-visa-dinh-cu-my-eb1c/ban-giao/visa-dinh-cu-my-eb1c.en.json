                    "product_hero_content_title": "What is the EB-1C green card?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The EB-1C is a U.S. immigrant visa that grants an unconditional green card to multinational managers and senior executives.",
