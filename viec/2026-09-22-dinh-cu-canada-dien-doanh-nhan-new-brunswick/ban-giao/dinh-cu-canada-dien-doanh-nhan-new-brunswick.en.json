            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "Is a work permit the same as permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is a work permit the same as permanent residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. A work permit gives you the temporary right to live and work in Canada. You need to complete your investment commitment, operate the business, and meet the residence conditions before you can apply for permanent residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do you have to run the business yourself?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Do you have to run the business yourself",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. You must actively manage and run the business in New Brunswick yourself. IMM Group and our partners can support you with the business plan, but we cannot operate the business on your behalf."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is an exploratory visit to New Brunswick mandatory?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is an exploratory visit to New Brunswick mandatory",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "An exploratory visit is not required before you apply. That said, visiting in person can help you understand the local market and prepare a stronger business plan."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "When can you apply for the provincial nomination?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "When can you apply for the provincial nomination",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "You can apply for a nomination once you have operated your business in New Brunswick for at least 6 continuous months and met the program conditions."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does your family have to live in New Brunswick?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Does your family have to live in New Brunswick",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Before you hold permanent residence, you and your family are expected to settle in the province you applied to and to honor your residence and business commitments."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can you live in another province once you hold permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Can you live in another province once you hold permanent residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Once you hold Canadian permanent residence, your family has the right to live and work in any province in Canada."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the main risks of the program?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "What are the main risks of the program",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The most common risks are a business plan that does not hold up in review, failure to operate the business as committed, failure to create the required full-time job, and weak documentation of your funds and management experience."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Who is New Brunswick right for?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Who is New Brunswick right for",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "It suits experienced business owners and senior managers who want to run a business in Canada themselves, with an investment starting at C$150,000 and a basic English requirement."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
