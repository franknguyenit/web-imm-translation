            "product_hero_content": [
                {
                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the New Brunswick Business Immigration Stream?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The New Brunswick Business Immigration Stream is a Canadian permanent residence pathway for business owners and senior managers who want to invest in, start, or acquire a business in the province.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "You must run the business in the province yourself to qualify for a provincial nomination and, from there, to apply for Canadian permanent residence.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Your spouse and children under 22 can be included in the same application.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A minimum investment of C$150,000 (approximately US$107,000).",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "New Brunswick is well placed for trade with the United States and Quebec, has a reasonable cost of living, and is home to several major universities and colleges.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A recent update: the province now calls this the Business Immigration Stream, replacing the former Entrepreneurial Stream. Under the current rules, you can apply for a nomination once your business has operated for 6 continuous months, provided you meet the program conditions.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
            ],
