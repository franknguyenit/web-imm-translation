            "product_faq_items": [
                {
                    "product_faq_item_question": "Is the Ontario Entrepreneur Stream still accepting new applications?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is the Ontario Entrepreneur Stream still accepting new applications",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. IMM Group's page states that the stream closed in February 2024. According to later OINP updates, the Entrepreneur Stream was formally closed on November 4, 2024, after application intake had been paused since December 2023."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is a work permit the same as permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is a work permit the same as permanent residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. A work permit is temporary permission to live and work in Canada. The investor had to complete the investment, business operation and residency commitments before applying for permanent residence (PR)."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Did the investor have to run the business personally?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Did the investor have to run the business personally",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. The investor had to manage and operate the Ontario business in person. An advisory firm can help with the business plan, but it cannot run the business on the investor's behalf."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Did the family have to live in Ontario?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Did the family have to live in Ontario",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Before permanent residence was granted, the investor and family had to stay established in the province they applied through, living and working there in line with the commitments they made to the stream."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "After permanent residence, can the family live in another province?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "After permanent residence, can the family live in another province",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Once permanent residence is granted, the family can live and work in any province in Canada, like any other permanent resident."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What were the main risks of the stream?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "What were the main risks of the stream",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The usual risks were a business plan that did not hold up under review, failure to meet the operating conditions, not creating enough jobs, or weak evidence of management experience and financial standing."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
