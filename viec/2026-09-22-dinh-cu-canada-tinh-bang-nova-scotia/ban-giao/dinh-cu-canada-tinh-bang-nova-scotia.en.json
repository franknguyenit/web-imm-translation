            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "Is a work permit the same as permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is a work permit the same as permanent residence?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. A work permit gives you temporary permission to live and work in Canada. You must complete your investment, business operating and residency commitments before you can apply for permanent residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do I have to run the business myself?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Do I have to run the business myself?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. You must be actively involved in managing and operating the business in Nova Scotia. An advisory firm can help with the business plan, but it cannot run the business on your behalf."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is an exploratory visit to Nova Scotia mandatory?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Is an exploratory visit to Nova Scotia mandatory?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "An exploratory visit is required if you are acquiring an existing business. It is an important step in assessing the business model and preparing your investment plan."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does my family have to live in Nova Scotia?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Does my family have to live in Nova Scotia?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Before you hold permanent residence, you and your family are expected to settle in the province you applied to and to honor your residence and business commitments."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can we live in another province once we have permanent residence?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Can we live in another province once we have permanent residence?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Once you hold Canadian permanent residence, you and your family are free to live and work in any province."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the main risks of the program?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "What are the main risks of the program?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Risk usually comes from a business plan that is not viable, a failure to operate the business as committed, a failure to create or maintain the required jobs, or weak documentation of your finances."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Who is Nova Scotia right for?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Who is Nova Scotia right for?",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "It suits experienced business owners and senior managers who want to run a business in Canada themselves, at an investment level that is more accessible than in many of Canada's larger provinces."
                                }
