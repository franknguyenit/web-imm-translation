                {
                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the Nova Scotia Entrepreneur Stream?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The Nova Scotia Entrepreneur Stream is for business owners and senior managers who want to invest in, start, or acquire a business in the province.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "You must run the business in the province yourself to qualify for Canadian permanent residence.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Your spouse and your unmarried children under 22 can be included in the same application.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "An investment starting at C$100,000 (approximately US$71,000) for a business outside Halifax Regional Municipality (HRM), or C$150,000 (approximately US$107,000) for a business inside HRM.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Nova Scotia has a lower cost of living and more affordable housing than many of Canada's larger provinces, and its position on the Atlantic coast is an advantage for trade.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
            ],
