            "product_conditions_icon": "fact_check",
            "product_conditions_title": "Program requirements",
            "product_conditions_items": [
                {
                    "product_conditions_item_icon": "wallet",
                    "product_conditions_item_title": "Net worth requirements",
                    "product_conditions_item_header": "",
                    "product_conditions_item_bullets": [
                        {
                            "product_conditions_item_bullet_text": "Has a personal net worth of at least C$600,000 (approximately US$428,000) if the business is in HRM."
                        },
                        {
                            "product_conditions_item_bullet_text": "Has a personal net worth of at least C$400,000 (approximately US$285,000) if the business is outside HRM."
                        }
                    ],
                    "product_conditions_item_footnote": ""
                },
                {
                    "product_conditions_item_icon": "person",
                    "product_conditions_item_title": "Principal applicant requirements",
                    "product_conditions_item_header": "",
                    "product_conditions_item_bullets": [
                        {
                            "product_conditions_item_bullet_text": "Has, within the past 10 years, owned and actively managed a business for at least 3 years, or held a senior management role for at least 5 years."
                        },
                        {
                            "product_conditions_item_bullet_text": "Meets the language requirement of Canadian Language Benchmark (CLB) 5 in English or French, roughly equivalent to an IELTS score of 5.0."
                        }
                    ],
                    "product_conditions_item_footnote": ""
                },
                {
                    "product_conditions_item_icon": "payments",
                    "product_conditions_item_title": "Investment requirements",
                    "product_conditions_item_header": "",
                    "product_conditions_item_bullets": [
                        {
                            "product_conditions_item_bullet_text": "Invests at least C$150,000 in a business in HRM."
                        },
                        {
                            "product_conditions_item_bullet_text": "Invests at least C$100,000 in a business outside HRM."
                        },
                        {
                            "product_conditions_item_bullet_text": "Presents a viable business plan that delivers economic benefit to the province."
                        },
                        {
                            "product_conditions_item_bullet_text": "Operates the business for at least 12 months to qualify to apply for permanent residence."
                        },
                        {
                            "product_conditions_item_bullet_text": "Creates at least 1 full-time job for a Canadian citizen or permanent resident when starting a new business, or maintains the existing jobs when acquiring an established business."
                        }
                    ],
                    "product_conditions_item_footnote": ""
                }
