                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the 888B visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The 888B Investor visa is Australia's permanent residence visa for investors who already hold a 188B visa.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "To move from the 188B provisional visa to 888B permanent residence, investors have to keep the complying investment in place and meet the residence requirement.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A spouse or partner and dependent children can be granted the visa at the same time.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Once they hold permanent residence and meet the requirements, investors become eligible to apply for Australian citizenship.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The 888B requires no additional investment once the transition requirements carried over from the 188B have been met.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
