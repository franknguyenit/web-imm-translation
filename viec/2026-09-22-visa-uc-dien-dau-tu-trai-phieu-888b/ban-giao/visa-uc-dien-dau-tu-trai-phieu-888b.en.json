            "product_faq_title": "888B visa FAQs",
            "product_faq_section_id": "faq-888b",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "How is the 888B visa different from the 188B?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "The difference between the 188B and the 888B",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The 188B is a provisional visa in the Investor stream. The 888B is the permanent visa, for investors who have maintained the investment and met the program's residence requirement."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the main requirements for the 888B?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Main requirements",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Investors have to maintain the A$2.5 million complying investment, live in Australia for at least 2 years in total within 3 years, and comply with Australian law."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do I have to prove my source of funds?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Source of funds",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Investors have to document a lawful and transparent source of funds. Assets commonly used include real estate, business assets, savings accounts, and shareholdings or listed shares."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Is the investment at risk?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Investment risk",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. The investment made under the 188B/888B program is an at-risk investment; returns and the recovery of capital depend on how the investment performs and on the terms of the fund."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can the capital be withdrawn after the 888B is granted?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Withdrawing the capital",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The capital can be withdrawn after the 888B application is approved, subject to the rules and the investment terms that apply at that time."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Who has to meet the residence requirement?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "The residence requirement",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The residence requirement can be met by either the applicant or the spouse or partner. Time spent in Australia by the applicant and by the spouse or partner cannot be added together, and children are not required to meet it."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does the 888B visa include Medicare?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Medicare",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Once 888B permanent residence is granted, the family is eligible for Medicare under the applicable rules. At the 188B stage, families normally need private health cover."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can I apply for Australian citizenship after the 888B?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "A path to citizenship",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Once they hold permanent residence and meet the residence, language, character, and citizenship test requirements, investors become eligible to apply for Australian citizenship."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                }
            ],
