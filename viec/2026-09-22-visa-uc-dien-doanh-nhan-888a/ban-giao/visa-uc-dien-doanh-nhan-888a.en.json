            "product_conditions_title": "Requirements for moving from 188A to 888A",
            "product_conditions_items": [
                {
                    "product_conditions_item_icon": "business_center",
                    "product_conditions_item_title": "Ownership and operation of the business",
                    "product_conditions_item_header": "",
                    "product_conditions_item_bullets": [
                        {
                            "product_conditions_item_bullet_text": "Establish or acquire a business in Australia."
                        },
                        {
                            "product_conditions_item_bullet_text": "Run and manage that business directly."
                        },
                        {
                            "product_conditions_item_bullet_text": "Hold at least a 30% ownership stake in the business, or the stake prescribed where the business turnover exceeds the prescribed level."
                        }
                    ],
                    "product_conditions_item_footnote": ""
                },
                {
                    "product_conditions_item_icon": "payments",
                    "product_conditions_item_title": "Turnover and assets",
                    "product_conditions_item_header": "",
                    "product_conditions_item_bullets": [
                        {
                            "product_conditions_item_bullet_text": "Record annual turnover of at least A$300,000 (approximately US$214,000) in the Australian business in at least 1 year."
                        },
                        {
                            "product_conditions_item_bullet_text": "In the 12 months before lodgement, meet 2 of these 3 requirements: total personal and business assets in Australia at the prescribed level; total investment in the Australian business at the prescribed level; or at least 2 full-time jobs created for Australian citizens or permanent residents, not counting family members."
                        }
                    ],
                    "product_conditions_item_footnote": ""
                },
