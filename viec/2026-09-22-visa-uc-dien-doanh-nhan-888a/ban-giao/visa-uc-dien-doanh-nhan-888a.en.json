            "product_faq_title": "888A visa FAQs",
            "product_faq_section_id": "faq-888a",
            "product_faq_mode": "flat",
            "product_faq_groups": false,
            "product_faq_items": [
                {
                    "product_faq_item_question": "How is the 888A visa different from the 188A?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "188A versus 888A",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The 188A is a provisional visa in the Business Innovation stream. The 888A is the permanent visa, for investors who have run a business and met the residence requirements in Australia."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "What are the main requirements for the 888A?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Main requirements",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The investor has to manage the Australian business directly, hold the required ownership stake, meet the turnover requirement, meet either the asset or the job-creation requirement, and complete the required period of residence."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Do I have to prove my source of funds?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Source of funds",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Investors have to show that the invested capital is lawful and fully documented. How the source of funds is explained differs from case to case."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can I buy an existing business in Australia?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Acquiring a business",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. The business you acquire should match your management experience and your business plan. Careful due diligence before the purchase matters, because a poorly chosen acquisition puts the application at risk."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can the business change industry?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Changing industry",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Adjustments are possible in the early stage where circumstances warrant. Before the 888A application, the business has to be trading steadily and meeting the requirements that apply."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Who has to meet the residence requirement?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The residence requirement can be met by either the applicant or the spouse or partner, as the applicable rules allow. Time spent in Australia by the applicant and by the spouse or partner cannot be added together."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Does the 888A visa include Medicare?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Medicare",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Once the 888A is granted, the family is eligible for Medicare as Australian permanent residents. At the 188A stage, investors normally need private health cover."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can I apply for Australian citizenship after the 888A?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "A path to citizenship",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Once they hold permanent residence and meet the residence, character, language, and citizenship test requirements, investors can lodge a citizenship application."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                }
            ],
