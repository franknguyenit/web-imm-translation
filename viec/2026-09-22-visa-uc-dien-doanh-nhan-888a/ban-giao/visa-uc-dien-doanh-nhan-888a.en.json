                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the 888A visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The 888A Business Innovation visa is Australia's permanent visa for investors who already hold a 188A visa in the Business Innovation stream.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Investors can move from the 188A provisional visa to 888A permanent residence once they have run the business and met the residence requirements in Australia.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A spouse or partner and dependent children can be granted the visa at the same time.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Once they hold the 888A and meet the residence requirements, investors can apply for Australian citizenship.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The 888A visa lets the investor continue to own and manage the Australian business as a permanent resident.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
