                            "product_faq_item_section_heading": "The spouse's role",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes, provided the spouse or partner holds the 188B visa as a family member and meets the conditions set out in the rules."
