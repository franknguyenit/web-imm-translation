                {
                    "product_hero_content_icon": "info",
                    "product_hero_content_title": "What is the 188B visa?",
                    "product_hero_content_text": [
                        {
                            "product_hero_content_text_item": "The 188B Investor visa was the Investor stream of Australia's Business Innovation and Investment Program, for investors with a track record in business or investment and substantial financial capacity.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "Investors had to place at least A$2,500,000 in complying investments in Australia.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The investment has to be held until the 888B permanent visa is granted, which cannot happen until at least 3 years later.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "A spouse or partner and children under 23 could be included in the same application.",
                            "product_hero_content_text_subs": false
                        },
                        {
                            "product_hero_content_text_item": "The program closed permanently to new applications on July 31, 2024. This page is a reference for applications already lodged and for the 888B stage that follows.",
                            "product_hero_content_text_subs": false
                        }
                    ]
                }
