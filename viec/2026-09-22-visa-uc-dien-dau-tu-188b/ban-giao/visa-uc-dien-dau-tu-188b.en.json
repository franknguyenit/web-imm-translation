            "product_faq_items": [
                {
                    "product_faq_item_question": "Is the 188B visa still open to new applications?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Program status",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. The subclass 188 program closed permanently to new applications on July 31, 2024. Applications lodged before that date continue to be processed under the rules in force."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Did the 188B require running a business in Australia?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "How the investment works",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "No. The 188B was an investment stream based on complying investments, and it did not require the investor to run a business in Australia."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Was proof of source of funds required?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Source of funds",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "Yes. Investors had to document a lawful and transparent source of funds and show how their assets had been accumulated."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Was English required?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "English",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "English was not a condition of lodging the application, but stronger English could add points and reduce the second instalment of the visa application charge payable by applicants without functional English."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "How much residence was needed before the 888B application?",
                    "product_faq_item_sections": [
                        {
                            "product_faq_item_section_heading": "Residence",
                            "product_faq_item_section_bullets": [
                                {
                                    "product_faq_item_section_bullet_text": "The applicant has to meet the residence conditions set out in the rules before lodging the 888B permanent visa application."
                                }
                            ],
                            "product_faq_item_section_note": ""
                        }
                    ]
                },
                {
                    "product_faq_item_question": "Can a spouse take over from the main applicant at the 888B stage?",
